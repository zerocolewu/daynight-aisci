DEBUG {'status': 'success', 'query': 'Mamba state space model molecular property prediction', 'count': 10, 'papers': [{'arxiv_id': '2510.08900v1', 'title':  
      'Few-shot Molecular Property Prediction: A Survey', 'authors': ['Zeyu Wang', 'Tianyi Jiang', 'Huanchang Ma', 'Yao Lu', 'Xiaoze Bao', 'Shanqing Yu', 'Qi
      Xuan', 'Shirui Pan', 'Xin Zheng'], 'summary': 'AI-assisted molecular property prediction has become a promising technique in early-stage drug discovery
