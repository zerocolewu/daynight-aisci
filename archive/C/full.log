      ### 3.2 Fourier-KAN Layer                                                                                                                              
      ```python                                                                                                                                              
      class FourierKANLayer(nn.Module):                                                                                                                      
          """                                                                                                                                                
          Kolmogorov-Arnold Network layer with Fourier basis functions.                                                                                      
          Replaces fixed activation with learnable Fourier series.                                                                                           
                                                                                                                                                             
          y = sum_k (a_k * cos(k*x) + b_k * sin(k*x))                                                                                                        
                                                                                                                                                             
          Advantages for polymers:                                                                                                                           
          - Periodic basis functions match polymer periodicity                                                                                               
          - Better function approximation than ReLU/GELU                                                                                                     
          - Learnable coefficients adapt to data                                                                                                             
          """                                                                                                                                                
          def __init__(self, in_features, out_features, num_frequencies=8):                                                                                  
              super().__init__()                                                                                                                             
              self.in_features = in_features                                                                                                                 
              self.out_features = out_features                                                                                                               
              self.num_frequencies = num_frequencies                                                                                                         
                                                                                                                                                             
              # Learnable Fourier coefficients                                                                                                               
              self.cos_weights = nn.Parameter(torch.randn(in_features, out_features, num_frequencies) * 0.1)                                                 
              self.sin_weights = nn.Parameter(torch.randn(in_features, out_features, num_frequencies) * 0.1)                                                 
              self.bias = nn.Parameter(torch.zeros(out_features))                                                                                            
                                                                                                                                                             
          def forward(self, x):                                                                                                                              
              # x: [batch, in_features]                                                                                                                      
              # Compute Fourier series for each input-output pair                                                                                            
              out = torch.zeros(x.shape[0], self.out_features, device=x.device)                                                                              
                                                                                                                                                             
              for k in range(self.num_frequencies):                                                                                                          
                  cos_term = torch.cos(k * x.unsqueeze(-1))  # [batch, in_features, 1]                                                                       
                  sin_term = torch.sin(k * x.unsqueeze(-1))                                                                                                  
                                                                                                                                                             
                  # Weighted sum across input features                                                                                                       
                  out = out + (cos_term * self.cos_weights[:, :, k].unsqueeze(0)).sum(dim=1)                                                                 
                  out = out + (sin_term * self.sin_weights[:, :, k].unsqueeze(0)).sum(dim=1)                                                                 
                                                                                                                                                             
              return out + self.bias                                                                                                                         
      ```                                                                                                                                                    
                                                                                                                                                             
      ### 3.3 GNN-SSM Layer                                                                                                                                  
      ```python                                                                                                                                              
      class GNNSSMLayer(nn.Module):                                                                                                                          
          """                                                                                                                                                
          GNN with State-Space Model for gradient flow control.                                                                                              
                                                                                                                                                             
          From "On Vanishing Gradients in GNNs" paper:                                                                                                       
          - Traditional GNNs suffer from "extreme gradient vanishing"                                                                                        
          - Jacobian singular values are scaled by squared adjacency eigenvalues                                                                             
          - Solution: H^(k+1)⊤ = ΛH^(k)⊤ + BX^(k)⊤ with eig(Λ) ≈ 1                                                                                           
                                                                                                                                                             
          This addresses overfitting by maintaining gradient flow through depth.                                                                             
          """                                                                                                                                                
          def __init__(self, hidden_dim, num_heads=4, spectral_radius=0.99):                                                                                 
              super().__init__()                                                                                                                             
              self.hidden_dim = hidden_dim                                                                                                                   
              self.spectral_radius = spectral_radius                                                                                                         
                                                                                                                                                             
              # State transition matrix Λ with controlled eigenvalues                                                                                        
              # Initialize as random unitary, then scale to desired spectral radius                                                                          
              U = torch.linalg.qr(torch.randn(hidden_dim, hidden_dim))[0]                                                                                    
              self.Lambda = nn.Parameter(U * spectral_radius)                                                                                                
                                                                                                                                                             
              # Input matrix B                                                                                                                               
              self.B = nn.Parameter(torch.randn(hidden_dim, hidden_dim) * 0.1)                                                                               
                                                                                                                                                             
              # Coupling function (message passing)                                                                                                          
              self.message_mlp = nn.Sequential(                                                                                                              
                  nn.Linear(hidden_dim * 2, hidden_dim),                                                                                                     
                  FourierKANLayer(hidden_dim, hidden_dim, num_frequencies=8)                                                                                 
              )                                                                                                                                              
                                                                                                                                                             
              self.norm = nn.LayerNorm(hidden_dim)                                                                                                           
                                                                                                                                                             
          def forward(self, h, edge_index, edge_attr=None):                                                                                                  
              """                                                                                                                                            
              h: [num_nodes, hidden_dim]                                                                                                                     
              edge_index: [2, num_edges]                                                                                                                     
              """                                                                                                                                            
              # Message passing (coupling function F_θ)                                                                                                      
              src, dst = edge_index                                                                                                                          
              messages = self.message_mlp(torch.cat([h[src], h[dst]], dim=-1))                                                                               
                                                                                                                                                             
              # Aggregate messages                                                                                                                           
              aggr = torch.zeros_like(h)                                                                                                                     
              aggr.scatter_add_(0, dst.unsqueeze(-1).expand(-1, self.hidden_dim), messages)                                                                  
                                                                                                                                                             
              # SSM update: H^(k+1)⊤ = ΛH^(k)⊤ + BX^(k)⊤                                                                                                     
              # Here X^(k) is the aggregated messages                                                                                                        
              h_new = torch.matmul(h, self.Lambda.T) + torch.matmul(aggr, self.B.T)                                                                          
                                                                                                                                                             
              return self.norm(h_new)                                                                                                                        
      ```                                                                                                                                                    
                                                                                                                                                             
      ### 3.4 Complete PolyKAN-SSM Architecture                                                                                                              
      ```python                                                                                                                                              
      class PolyKANSSM(nn.Module):                                                                                                                           
          """                                                                                                                                                
          PolyKAN-SSM: Integrating Fourier-KAN, GNN-SSM, and Non-covalent edges.                                                                             
                                                                                                                                                             
          Architecture:                                                                                                                                      
          1. Node/Edge embedding with Fourier-KAN                                                                                                            
          2. 4 GNN-SSM layers for message passing with gradient control                                                                                      
          3. Attention-based pooling for intensive property (Tg)                                                                                             
          4. MLP head with Fourier-KAN activations                                                                                                           
          """                                                                                                                                                
          def __init__(self, node_dim, edge_dim, hidden_dim=256, num_layers=4, num_heads=4):                                                                 
              super().__init__()                                                                                                                             
                                                                                                                                                             
              # Node/Edge embedding                                                                                                                          
              self.node_embed = nn.Sequential(                                                                                                               
                  nn.Linear(node_dim, hidden_dim),                                                                                                           
                  FourierKANLayer(hidden_dim, hidden_dim, num_frequencies=8)                                                                                 
              )                                                                                                                                              
              self.edge_embed = nn.Sequential(                                                                                                               
                  nn.Linear(edge_dim, hidden_dim),                                                                                                           
                  FourierKANLayer(hidden_dim, hidden_dim, num_frequencies=8)                                                                                 
              )                                                                                                                                              
                                                                                                                                                             
              # GNN-SSM layers                                                                                                                               
              self.ssm_layers = nn.ModuleList([                                                                                                              
                  GNNSSMLayer(hidden_dim, num_heads, spectral_radius=0.99)                                                                                   
                  for _ in range(num_layers)                                                                                                                 
              ])                                                                                                                                             
                                                                                                                                                             
              # Attention-based pooling (validated in Day 4)                                                                                                 
              self.attention_pool = nn.Sequential(                                                                                                           
                  nn.Linear(hidden_dim, hidden_dim),                                                                                                         
                  FourierKANLayer(hidden_dim, 1, num_frequencies=8)                                                                                          
              )                                                                                                                                              
                                                                                                                                                             
              # Prediction head                                                                                                                              
              self.head = nn.Sequential(                                                                                                                     
                  nn.Linear(hidden_dim, hidden_dim),                                                                                                         
                  FourierKANLayer(hidden_dim, hidden_dim, num_frequencies=8),                                                                                
                  nn.Dropout(0.1),                                                                                                                           
                  nn.Linear(hidden_dim, 1)                                                                                                                   
              )                                                                                                                                              
                                                                                                                                                             
          def forward(self, batch):                                                                                                                          
              # Embed nodes and edges                                                                                                                        
              h = self.node_embed(batch.x)                                                                                                                   
              edge_attr = self.edge_embed(batch.edge_attr)                                                                                                   
                                                                                                                                                             
              # GNN-SSM layers                                                                                                                               
              for ssm_layer in self.ssm_layers:                                                                                                              
                  h = ssm_layer(h, batch.edge_index, edge_attr)                                                                                              
                                                                                                                                                             
              # Attention-based pooling for intensive property                                                                                               
              attn_weights = self.attention_pool(h)  # [num_nodes, 1]                                                                                        
              attn_weights = torch.softmax(attn_weights, dim=0)                                                                                              
                                                                                                                                                             
              # Graph-level representation                                                                                                                   
              graph_repr = (h * attn_weights).sum(dim=0, keepdim=True)  # [1, hidden_dim]                                                                    
                                                                                                                                                             
              # Predict Tg                                                                                                                                   
              out = self.head(graph_repr)                                                                                                                    
              return out.squeeze()                                                                                                                           
      ```                                                                                                                                                    
                                                                                                                                                             
      ## 4. Experimental Strategy                                                                                                                            
                                                                                                                                                             
      ### 4.1 Data Processing                                                                                                                                
      1. Load Tg dataset (7170 samples)                                                                                                                      
      2. For each SMILES:                                                                                                                                    
         - Generate 3D conformer with RDKit (ETKDG, max 1 conformer)                                                                                         
         - If conformer generation succeeds:                                                                                                                 
           - Extract atom positions                                                                                                                          
           - Build covalent edges from bonds                                                                                                                 
           - Build non-covalent edges (distance < 5Å, excluding covalent)                                                                                    
         - If conformer generation fails:                                                                                                                    
           - Use 2D graph with shortest path distances as proxy                                                                                              
      3. Node features: atom type (one-hot), degree, hybridization, aromaticity, formal charge, is_in_ring                                                   
      4. Edge features: bond type (one-hot), conjugated, in_ring, distance encoding (Gaussian basis)                                                         
                                                                                                                                                             
      ### 4.2 Training                                                                                                                                       
      - Optimizer: AdamW (lr=1e-3, weight_decay=1e-4)                                                                                                        
      - Scheduler: ReduceLROnPlateau (patience=10, factor=0.5)                                                                                               
      - Loss: MSE                                                                                                                                            
      - Batch size: 32                                                                                                                                       
      - Early stopping: patience=30 on validation RMSE                                                                                                       
      - Max epochs: 500                                                                                                                                      
      - 5 random seeds for ensemble                                                                                                                          
                                                                                                                                                             
      ### 4.3 Evaluation                                                                                                                                     
      - Metric: RMSE on test set                                                                                                                             
      - Compare against: SOTA 30.8 (PerioGT), current best 34.14 (Day 1)                                                                                     
      - Target: Beat SOTA 30.8                                                                                                                               
                                                                                                                                                             
      ## 5. Diagnostic Analysis                                                                                                                              
                                                                                                                                                             
      ### 5.1 Gradient Flow Analysis                                                                                                                         
      - Monitor layer-wise Jacobian eigenvalues                                                                                                              
      - Track Dirichlet energy evolution                                                                                                                     
      - Compare with vanilla GNN baseline                                                                                                                    
                                                                                                                                                             
      ### 5.2 Overfitting Analysis                                                                                                                           
      - Track train vs validation loss curves                                                                                                                
      - Compare with Day 4 results (train ~12-17, val ~35-37)                                                                                                
      - Analyze if GNN-SSM reduces the gap                                                                                                                   
                                                                                                                                                             
      ### 5.3 Ablation Studies                                                                                                                               
      1. PolyKAN-SSM (full) vs without Fourier-KAN (use GELU)                                                                                                
      2. PolyKAN-SSM vs without GNN-SSM (use standard GIN)                                                                                                   
      3. PolyKAN-SSM vs without non-covalent edges                                                                                                           
      4. Spectral radius ablation (0.9, 0.95, 0.99, 1.0)                                                                                                     
                                                                                                                                                             
      ### 5.4 Feature Visualization                                                                                                                          
      - t-SNE of learned representations                                                                                                                     
