      source</td><td>#target</td><td>Formula</td></tr><tr><td>CA</td><td>1</td><td>68</td><td>RCOO</td></tr><tr><td>Ester</td><td>1</td><td>7</td><td>RCOOR&#
      x27;</td></tr><tr><td>Ketone</td><td>1</td><td>15</td><td>ROR&#x27;</td></tr><tr><td>Phenyl</td><td>22</td><td>36</td><td>Aromatic                     
      Rings</td></tr><tr><td>Tbutyl</td><td>1</td><td>10</td><td>C4</td></tr><tr><td>dsAmide</td><td>4</td><td>18</td><td>RONR&#x27;R&quot;</td></tr><tr><td>
      msAmide</td><td>2</td><td>32</td><td>RONR&#x27;</td></tr><tr><td>nsAmide</td><td>4</td><td>32</td><td>RON</td></tr><tr><td>Total</td><td>36</td><td>218
      </td><td>-</td></tr></table>                                                                                                                           
                                                                                                                                                             
